# kopsrox kernel config fragment for pve-microvm
# merged on top of pve-microvm's kernel config by dev/build-kopsrox-kernel.sh
# everything built-in ( =y ) - pve-microvm guests have no /lib/modules

# container networking basics
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_BRIDGE_NETFILTER=y

# flannel vxlan backend
CONFIG_VXLAN=y
CONFIG_NET_UDP_TUNNEL=y

# gates most xt_* matches - without it olddefconfig drops them
CONFIG_NETFILTER_ADVANCED=y

# kube-proxy / flannel iptables requirements
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NF_CT_NETLINK=y

# nftables backend + iptables-nft compat
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y

# ipset ( used by k3s network policy controller )
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_NET=y

# runc on cgroup v2 needs bpf for the device controller
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# cpu limits
CONFIG_CFS_BANDWIDTH=y

# nfs client ( extra_packages nfs-common )
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y

# misc k3s
CONFIG_DUMMY=y

# expose /proc/config.gz so k3s check-config works
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# optional flannel wireguard backend
CONFIG_WIREGUARD=y
